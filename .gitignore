# ===========================================
# Node.js
# ===========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ===========================================
# Build outputs
# ===========================================
frontend/build/
build.log
truenas-build/

# ===========================================
# Database files (live data, not in repo)
# ===========================================
*.db
*.db-shm
*.db-wal

# ===========================================
# Environment / secrets
# ===========================================
.env
.env.*

# ===========================================
# Python
# ===========================================
.venv/
__pycache__/
*.pyc
*.pyo

# ===========================================
# IDE / Editor
# ===========================================
.vscode/
.idea/
*.swp
*.swo

# ===========================================
# OS generated files
# ===========================================
.DS_Store
Thumbs.db
desktop.ini

# ===========================================
# Debug / temp files
# ===========================================
backend/debug_*
backend/temp/

# ===========================================
# Extra content (ML models, training data, etc.)
# Large folder — not needed in the repo
# ===========================================
extra/

# ===========================================
# ML models & training data (large binaries)
# ===========================================
*.pt
*.pth
*.onnx
*.bin
*.safetensors
backend/ml-datasets/
backend-pairwise/models/

# ===========================================
# Standalone ML / vision projects (separate repos)
# ===========================================
vision-llm-pairwise/

# AI training data (large binary files)
AI-Inference-App/training_data/

# Local Scene Manager - test data and debug outputs
AI-Inference-App/localscene/test/
AI-Inference-App/localscene/debug/
*.mp4

# TLS certs/keys — self-signed per machine, regenerated on first run
# (a committed cert's SAN would only match one machine's IP anyway)
vr-reference/*.pem
data/

# Demo video: captured app screenshots contain real library content, and the
# render artifacts are large. The composition source (script.json, the build
# script, GUIDE.md) is tracked; the pixels are not.
demo/acm-demo/assets/shots/
demo/acm-demo/snapshots/
demo/acm-demo/out/
demo/acm-demo/renders/
demo/narration/
demo/narration.wav
demo/page-text.txt

# funpipe runtime state (queue + review editor log), regenerated at run time
AI-Inference-App/funpipe_queue.json
AI-Inference-App/funpipe_ui.log
